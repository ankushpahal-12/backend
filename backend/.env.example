# ═══════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345678
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-12345678
JWT_EXPIRES_IN=24h
COOKIE_EXPIRES_IN=24

# HMAC Signature Authentication (for request signing)
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
HMAC_SECRET=your-strong-hmac-secret-key-for-request-signing-12345678
# Signature mode: off | monitor | enforce
SIGNATURE_MODE=monitor

# Email Service (Mailtrap for development)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-user@example.com
EMAIL_PASS=your-mailtrap-password
EMAIL_FROM=no-reply@finotive.com
EMAIL_SECURITY_FROM=security@finotive.com

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-Token,X-Body-Signature
CORS_EXPOSED_HEADERS=RateLimit-Limit,RateLimit-Remaining,RateLimit-Reset
CORS_MAX_AGE=86400

# Internal Service Secret (for inter-service communication)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-key-12345678

# ═══════════════════════════════════════════════════════════════
# REVERSE PROXY & SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Trusted proxy IPs (comma-separated, for production)
# Example: TRUSTED_PROXIES=10.0.0.1,10.0.0.2,172.31.0.0/16
TRUSTED_PROXIES=127.0.0.1,localhost

# Allowed Host headers (comma-separated)
# Used to validate Host header and prevent Host header injection attacks
ALLOWED_HOSTS=localhost:5000,localhost:5173,yourdomain.com

# Cookie settings (production)
# Use a real parent domain in production (example: .yourdomain.com)
COOKIE_DOMAIN=
# Allowed values: none, lax, strict
COOKIE_SAMESITE=none

# Rate limiting
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_STRICT_AUTH_MAX=5
RATE_LIMIT_STRICT_AUTH_WINDOW_MS=3600000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=6
RATE_LIMIT_OTP_WINDOW_MS=600000
RATE_LIMIT_RESET_MAX=4
RATE_LIMIT_RESET_WINDOW_MS=1800000
RATE_LIMIT_ADMIN_LOGIN_MAX=4
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_OTP_MAX=3
RATE_LIMIT_ADMIN_OTP_WINDOW_MS=900000
RATE_LIMIT_EMAIL_CHECK_MAX=5
RATE_LIMIT_EMAIL_CHECK_WINDOW_MS=600000

# ═══════════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════
# 
# 1. Generate secure secrets in production:
#    node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
#    node -e "console.log('HMAC_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
#
# 2. REVERSE PROXY SETUP (Production):
#    - Set NODE_ENV=production
#    - Configure TRUSTED_PROXIES with actual proxy/LB IPs
#    - Configure ALLOWED_HOSTS with real domain only (no localhost)
#    - Configure ALLOWED_ORIGINS with real frontend origin only (no localhost)
#    - Configure COOKIE_DOMAIN with your domain when COOKIE_SAMESITE=none
#    - Ensure proxy sets X-Forwarded-Proto: https
#    - Ensure proxy sets X-Forwarded-For header
#
# 3. SECURITY PROTECTIONS ENABLED:
#    ✓ Proxy header validation (prevents spoofing)
#    ✓ Reverse engineering tool detection (Burp, Fiddler, etc.)
#    ✓ Stack trace obfuscation (prevents info leakage)
#    ✓ Request format validation
#    ✓ Rate limiting per IP
#    ✓ HTTPS enforcement in production
#    ✓ Host header validation
#    ✓ TRACE/OPTIONS method restrictions
#
# 4. Always use HTTPS in production
# 5. Store secrets in a secure vault (AWS Secrets Manager, Azure Key Vault, etc.)
# 6. Never commit this file with real secrets to version control
# 7. Rotate secrets regularly in production
#
# ═══════════════════════════════════════════════════════════════
